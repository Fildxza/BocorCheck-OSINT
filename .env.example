# Copy to .env and fill in real values. .env is git-ignored — never commit it.

# --- Telegram (create a bot with @BotFather) ---
TELEGRAM_BOT_TOKEN=
# Your numeric chat ID; the bot logs it when you message it. Leave empty to allow any chat.
TELEGRAM_CHAT_ID=

# --- Have I Been Pwned ---
HIBP_API_KEY=

# --- MySQL ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=fyp_user
MYSQL_PASSWORD=
MYSQL_DATABASE=fyp_osint

# --- Flask / admin ---
FLASK_SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
